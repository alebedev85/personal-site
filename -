.section {
  --bio-black: #0a0a0c;
  --bio-panel: #13141c;
  --bio-border: #2a2b38;
  --bio-white: #fff;
  --bio-shadow: #000;
  --bio-yellow: #ffd13b;
  --bio-red: #ff3344;
  --bio-cyan: #00f0ff;
  --bio-green: #25e076;
  --bio-text: #e1e3e9;
  --bio-muted: #9295a3;
  --bio-detail: #555866;
  --bio-cyan-shadow: #007788;
  --bio-font-pixel: "Press Start 2P", "Courier New", monospace;
  --bio-font-silk: Silkscreen, "Courier New", monospace;
  box-sizing: border-box;
  color: var(--bio-text);
  font-family: var(--bio-font-pixel);
  font-size: 12px;
  line-height: 1.6;
  scroll-margin-top: 90px;
}
.section *,
.section *::before,
.section *::after {
  box-sizing: border-box;
}

.section[data-theme=light] {
  --bio-black: #e8eaf6;
  --bio-panel: #f3f4fa;
  --bio-border: #bfc6d8;
  --bio-text: #161b26;
  --bio-muted: #50596e;
}

.sectionHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  padding-bottom: 5px;
  border-bottom: 2px solid var(--bio-border);
}

.sectionHeading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10px;
}
.sectionHeading h2 {
  margin: 0;
  color: var(--bio-yellow);
  font-size: clamp(9px, 1.1vw, 12px);
  line-height: 1.7;
  text-transform: uppercase;
}

.sectionMarker {
  width: 11px;
  height: 11px;
  flex: 0 0 11px;
  transform: rotate(45deg);
  background: var(--bio-red);
}

.statusBadge {
  flex: 0 0 auto;
  padding: 2px 6px;
  border: 1px solid currentcolor;
  color: var(--bio-green);
  font-size: 8px;
  font-weight: 700;
  white-space: nowrap;
}

.panel {
  position: relative;
  padding: 20px;
  border: 3px solid var(--bio-yellow);
  background: var(--bio-panel);
  box-shadow: inset 2px 2px 0 rgba(255, 255, 255, 0.08), inset -2px -2px 0 rgba(10, 10, 12, 0.6), 4px 4px 0 var(--bio-shadow);
  transition: border-color 180ms ease, background-color 180ms ease;
}

.panelStatus {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--bio-border);
  color: var(--bio-muted);
  font-size: 8px;
}
.panelStatus > span:first-child {
  color: var(--bio-yellow);
}

.specValue {
  color: var(--bio-yellow);
}

.health {
  color: var(--bio-muted);
  white-space: nowrap;
}
.health span {
  color: var(--bio-red);
}

.bioIntro {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 16px;
}

.avatar {
  position: relative;
  display: flex;
  width: 64px;
  height: 64px;
  flex: 0 0 64px;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--bio-cyan);
  background: var(--bio-black);
  color: var(--bio-cyan);
  box-shadow: 4px 4px 0 var(--bio-cyan-shadow);
}
.avatar svg {
  width: 40px;
  height: 40px;
}
.avatar span {
  position: absolute;
  right: -6px;
  bottom: -7px;
  padding: 0 4px;
  background: var(--bio-red);
  color: var(--bio-white);
  font-size: 8px;
  font-weight: 700;
}

.dialogue {
  flex: 1;
  padding: 12px;
  border: 2px dashed var(--bio-detail);
  background: var(--bio-black);
  color: var(--bio-text);
  font-family: var(--bio-font-silk);
  font-size: 12px;
  line-height: 1.65;
}
.dialogue strong {
  display: block;
  margin-bottom: 4px;
  color: var(--bio-yellow);
  font-family: var(--bio-font-pixel);
  font-size: 8px;
}
.dialogue p {
  margin: 0;
  color: inherit;
  font: inherit;
}

.bioCopy {
  padding: 14px;
  border: 1px solid var(--bio-border);
  background: var(--bio-black);
  color: var(--bio-text);
  font-family: var(--bio-font-silk);
  font-size: 12px;
  line-height: 1.75;
}
.bioCopy p {
  margin: 0;
  color: inherit;
  font: inherit;
}

.section .bioCopy a {
  color: var(--bio-cyan);
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.section .bioCopy a:nth-of-type(2) {
  color: var(--bio-yellow);
}

.specGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--bio-border);
}

.spec {
  display: flex;
  min-height: 54px;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
  padding: 8px;
  border: 1px solid var(--bio-border);
  background: var(--bio-black);
  font-size: 8px;
}
.spec > span {
  color: var(--bio-muted);
}
.spec strong {
  font-size: 8px;
}

@media (max-width: 600px) {
  .sectionHeader {
    align-items: flex-start;
  }
  .statusBadge {
    font-size: 7px;
    white-space: normal;
    text-align: center;
  }
  .sectionHeading h2 {
    font-size: 9px;
  }
  .panel {
    padding: 14px;
  }
  .bioIntro {
    gap: 12px;
  }
  .avatar {
    width: 52px;
    height: 52px;
    flex-basis: 52px;
  }
  .avatar svg {
    width: 32px;
    height: 32px;
  }
  .dialogue,
  .bioCopy {
    font-size: 11px;
  }
  .specGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
